# Control-plane UI, production image: a static React build served by nginx.
# This is the image release.sh publishes. frontend/Dockerfile is the development
# server, used only by the local docker-compose.yml.
#
# ECR Public mirrors of the Docker official images (not Docker Hub).

# ── Build ─────────────────────────────────────────────────────────────────
# Pinned by digest, as in frontend/Dockerfile.
FROM public.ecr.aws/docker/library/node:22-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a AS build
WORKDIR /app
COPY package.json package-lock.json ./
# npm ci installs exactly what package-lock.json records.
RUN npm ci --no-audit --no-fund
COPY index.html vite.config.js ./
COPY public ./public
COPY src ./src
# No REACT_APP_API_URL is baked in: the API address is derived in the browser
# from the page's own address and the runtime settings in config.js
# (src/apiUrl.js), so the same image works in every AccessMode.
# vite build writes build/, with the bundle under build/static/.
RUN npm run build

# ── Serve ─────────────────────────────────────────────────────────────────
# Pinned by digest like the build stage (Jira story F181); nginx 1.31.9 when pinned.
FROM public.ecr.aws/docker/library/nginx:alpine@sha256:fb4658584bd9a916ffb6f6e365f97c25cfdb2923801f551ea08356e695f14ff7
RUN apk upgrade --no-cache && rm -rf /var/cache/apk/*

# The image's default server and its IPv6 helper are replaced by nginx.conf.
RUN rm -f /etc/nginx/conf.d/default.conf \
          /docker-entrypoint.d/10-listen-on-ipv6-by-default.sh
COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/ecdl-security-headers.conf /etc/nginx/ecdl-security-headers.conf
COPY docker-entrypoint.d/40-ecdl-config.sh /docker-entrypoint.d/40-ecdl-config.sh
COPY --from=build /app/build /usr/share/nginx/html

# The only files written at runtime are config.js and ecdl-api.conf (where
# /api/* is forwarded); everything else stays read-only to the nginx user.
RUN chmod 0755 /docker-entrypoint.d/40-ecdl-config.sh \
 && touch /etc/nginx/ecdl-api.conf \
 && chown nginx:nginx /usr/share/nginx/html/config.js /etc/nginx/ecdl-api.conf

USER nginx
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:3000/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
