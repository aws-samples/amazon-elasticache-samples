<mxfile host="app.diagrams.net" agent="ECDL">
  <diagram id="ecdl-arch" name="ECDL Architecture">
    <mxGraphModel dx="1400" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" background="#ffffff" pageScale="1" pageWidth="1400" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" vertex="1" style="text;html=1;fontSize=20;fontStyle=1;align=center;" value="ECDL — keep an ElastiCache for Valkey cache in sync with your database">
          <mxGeometry x="300" y="24" width="800" height="30" as="geometry" />
        </mxCell>

        <!-- application (above the target) -->
        <mxCell id="app" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" value="&lt;b&gt;Application&lt;/b&gt;&lt;br&gt;fast reads">
          <mxGeometry x="1090" y="96" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- main pipeline (left to right) -->
        <mxCell id="src" parent="1" vertex="1" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="&lt;b&gt;Source database&lt;/b&gt;&lt;br&gt;MySQL · PostgreSQL&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;SQL Server, Oracle:&lt;br&gt;not tested in this release&lt;/font&gt;">
          <mxGeometry x="40" y="270" width="180" height="130" as="geometry" />
        </mxCell>

        <mxCell id="dbz" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="&lt;b&gt;Debezium&lt;/b&gt;&lt;br&gt;CDC collector">
          <mxGeometry x="310" y="285" width="170" height="100" as="geometry" />
        </mxCell>

        <mxCell id="broker" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="&lt;b&gt;Valkey Streams&lt;/b&gt;&lt;br&gt;broker / buffer">
          <mxGeometry x="560" y="285" width="190" height="100" as="geometry" />
        </mxCell>

        <mxCell id="sink" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" value="&lt;b&gt;Sink&lt;/b&gt;&lt;br&gt;transform + write">
          <mxGeometry x="830" y="285" width="170" height="100" as="geometry" />
        </mxCell>

        <mxCell id="tgt" parent="1" vertex="1" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" value="&lt;b&gt;ElastiCache for Valkey&lt;/b&gt;&lt;br&gt;your cache">
          <mxGeometry x="1090" y="270" width="180" height="130" as="geometry" />
        </mxCell>

        <!-- initial-load arc: source -> target, over the top -->
        <mxCell id="e_init" parent="1" edge="1" source="src" target="tgt" style="edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;rounded=1;html=1;fontSize=12;fontStyle=1;strokeColor=#27ae60;strokeWidth=2.5;fontColor=#1e7e46;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" value="&#9312;  initial bulk load — one-time, parallel (fills the cache, bypasses the broker)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="130" y="220" /><mxPoint x="1135" y="220" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- cdc flow (left to right along the row) -->
        <mxCell id="e_src_dbz" parent="1" edge="1" source="src" target="dbz" style="edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;rounded=0;html=1;fontSize=12;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="&#9313; change log">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-14" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e_dbz_broker" parent="1" edge="1" source="dbz" target="broker" style="edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;rounded=0;html=1;fontSize=12;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="publish">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-14" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e_broker_sink" parent="1" edge="1" source="broker" target="sink" style="edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;rounded=0;html=1;fontSize=12;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="consume">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-14" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e_sink_tgt" parent="1" edge="1" source="sink" target="tgt" style="edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;rounded=0;html=1;fontSize=12;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="write">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-14" as="offset" /></mxGeometry>
        </mxCell>

        <!-- target -> app -->
        <mxCell id="e_tgt_app" parent="1" edge="1" source="tgt" target="app" style="edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;rounded=0;html=1;fontSize=12;strokeWidth=2;strokeColor=#b85450;fontColor=#843534;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" value="reads">
          <mxGeometry relative="1" as="geometry"><mxPoint x="22" as="offset" /></mxGeometry>
        </mxCell>

        <!-- phase caption -->
        <mxCell id="caption" parent="1" vertex="1" style="text;html=1;fontSize=12;align=center;fontColor=#555555;" value="&#9312; Initial load fills the cache once (parallel, direct).&lt;br&gt;&#9313; Change data capture then keeps it fresh — every committed change, usually within a second, transformed on the way.">
          <mxGeometry x="300" y="440" width="800" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
