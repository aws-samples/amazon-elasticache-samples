  "apply": [
    {"name": "a rename onto an existing column replaces it", "spec": {"rename": {"a": "b"}},
     "row": {"a": "1", "b": "2", "c": "3"}, "keep": true, "fields": {"b": "1", "c": "3"}},
    {"name": "two columns can swap names", "spec": {"rename": {"a": "b", "b": "a"}},
     "row": {"a": "1", "b": "2"}, "keep": true, "fields": {"a": "2", "b": "1"}},
    {"name": "a computed field replaces a column and can be renamed",
     "spec": {"computed": [{"name": "a", "expr": "a * 2"}], "rename": {"a": "double"}},
     "row": {"a": "4", "z": "x"}, "keep": true, "fields": {"double": "8", "z": "x"}},
    {"name": "columns keep only listed fields; computed fields are always kept",
     "spec": {"columns": ["id", "missing"], "computed": [{"name": "n", "expr": "id + 1"}]},
     "row": {"id": "1", "other": "x"}, "keep": true, "fields": {"id": "1", "n": "2"}},
    {"name": "the filter reads the original row", "spec": {"filter": {"field": "a", "op": ">", "value": "1"},
     "rename": {"a": "b"}}, "row": {"a": "2"}, "keep": true, "fields": {"b": "2"}},
    {"name": "a dropped row", "spec": {"filter": {"field": "a", "op": ">", "value": "1"}},
     "row": {"a": "1"}, "keep": false}
  ],
