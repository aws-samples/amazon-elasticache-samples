{
  "about": "The row identity in a cache key (<prefix><table>:<pk>), shared by the Go sink and the bulk loader. The sink derives <pk> from the change event's key (pkFromMsg, main.go); the loader from the row it read (sink_pk, data-plane/bulk-loader/bulk_loader.py). Both test suites read this file, so a change to either format fails the other's tests. key_columns is the primary key in declared order; key_json is the record key as Debezium sends it (columns in key order); row is the source row, where {\"$decimal\": \"...\"} is a DECIMAL/NUMERIC value. Composite values are joined with ':' in the sorted order of the column names, not key order.",
  "cases": [
    {"name": "single integer", "key_columns": ["id"],
     "row": {"id": 42, "name": "x"}, "key_json": "{\"id\":42}", "pk": "42"},
    {"name": "negative integer", "key_columns": ["id"],
     "row": {"id": -7}, "key_json": "{\"id\":-7}", "pk": "-7"},
    {"name": "integer above 2^53 keeps every digit", "key_columns": ["id"],
     "row": {"id": 9007199254740993}, "key_json": "{\"id\":9007199254740993}",
     "pk": "9007199254740993"},
    {"name": "single text key", "key_columns": ["sku"],
     "row": {"sku": "AB-1", "qty": 3}, "key_json": "{\"sku\":\"AB-1\"}", "pk": "AB-1"},
    {"name": "decimal key as Debezium's string", "key_columns": ["price_id"],
     "row": {"price_id": {"$decimal": "12.50"}}, "key_json": "{\"price_id\":\"12.50\"}",
     "pk": "12.50"},
    {"name": "two columns, joined in name order", "key_columns": ["order_id", "line_no"],
     "row": {"order_id": 7, "line_no": 2, "qty": 1},
     "key_json": "{\"order_id\":7,\"line_no\":2}", "pk": "2:7"},
    {"name": "two columns already in name order", "key_columns": ["a_id", "b_id"],
     "row": {"a_id": 1, "b_id": 10}, "key_json": "{\"a_id\":1,\"b_id\":10}", "pk": "1:10"},
    {"name": "three columns, text and integer", "key_columns": ["tenant", "region", "id"],
     "row": {"tenant": "acme", "region": "eu", "id": 9, "v": "z"},
     "key_json": "{\"tenant\":\"acme\",\"region\":\"eu\",\"id\":9}", "pk": "9:eu:acme"},
    {"name": "upper-case names sort by byte", "key_columns": ["ORDER_ID", "LINE"],
     "row": {"ORDER_ID": 100, "LINE": 3},
     "key_json": "{\"ORDER_ID\":100,\"LINE\":3}", "pk": "3:100"},
    {"name": "upper case sorts before lower case", "key_columns": ["b", "A"],
     "row": {"b": "lower", "A": "upper"},
     "key_json": "{\"b\":\"lower\",\"A\":\"upper\"}", "pk": "upper:lower"},
    {"name": "a value containing the separator", "key_columns": ["k1", "k2"],
     "row": {"k1": "a:b", "k2": "c"}, "key_json": "{\"k1\":\"a:b\",\"k2\":\"c\"}",
     "pk": "a:b:c"}
  ]
}
