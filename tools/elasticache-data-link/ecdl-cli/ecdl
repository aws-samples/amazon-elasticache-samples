#!/usr/bin/env python3
"""
ECDL CLI — Deploy and manage ElastiCache Data Link pipelines.

Usage:
  ecdl validate my-link.yaml             # check a link config against the schema
  ecdl resolve  my-link.yaml             # what ECDL reads from the config's ARNs
  ecdl plan     my-link.yaml             # the ordered deployment; changes nothing
  ecdl apply    my-link.yaml             # deploy, or update a deployed link in place
  ecdl diff     deployed.yaml desired.yaml
  ecdl signal   ddl|snapshot my-link.yaml
  ecdl status   --stack ecdl-<link>-cdc  # a stack's outputs
  ecdl destroy  --link <link>            # delete a link's stacks (keeps source + target)
"""

import argparse
import json
import os
import sys

# The link schema and validator live at the repo root and are shared with the
# control-plane API, so a config this CLI accepts is one the UI accepts.
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from ecdl_link import (  # noqa: E402
    LinkValidationError,
    canonical_json,
    load_file,
    problems_for,
    validate_link,
)


# ═══════════════════════════════════════════════════════════════
# HELPERS
# ═══════════════════════════════════════════════════════════════

def _load_or_exit(path, what="nothing to do"):
    """The raw document of a link file, or exit with what is wrong with it.

    A file that is not valid YAML or JSON used to end every command but
    `validate` with a traceback (Jira story F143).
    """
    if not os.path.exists(path):
        print(f"  ERROR: {path} not found")
        sys.exit(1)
    try:
        return load_file(path)
    except LinkValidationError as exc:
        print(f"  x {path} could not be read, so there is {what}:")
        for problem in exc.problems:
            print(f"      {problem}")
        sys.exit(1)
    except (OSError, UnicodeDecodeError) as exc:
        print(f"  x {path} could not be read: {exc}")
        sys.exit(1)


def _cloudformation(profile, region):
    """A CloudFormation client for --profile / --region (either may be unset).

    The SDK rather than shelling out to the aws CLI: nothing is executed, so a
    stack name from the command line can never be read as a command.
    """
    import boto3
    return boto3.session.Session(profile_name=profile or None,
                                 region_name=region or None).client('cloudformation')


