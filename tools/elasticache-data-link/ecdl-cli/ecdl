def _positive_minutes(text):
    try:
        value = int(text)
    except ValueError:
        raise argparse.ArgumentTypeError(f"{text!r} is not a whole number of minutes")
    if value < 1:
        raise argparse.ArgumentTypeError("must be at least 1 minute")
    return value


def main():
    parser = argparse.ArgumentParser(prog="ecdl", description="ECDL CLI — Manage CDC pipelines")
    # Defaults come from the standard AWS environment, NOT from this repo's own
    # development account. They used to be "testing" and "us-east-2", so anyone
    # else running `ecdl` without flags got "profile not found" -- or, worse,
    # deployed into the wrong region of whatever account that profile named.
    parser.add_argument("--profile", default=os.environ.get("AWS_PROFILE"),
                        help="AWS CLI profile (default: $AWS_PROFILE, else the "
                             "default credential chain)")
    parser.add_argument("--region", default=(os.environ.get("AWS_REGION")
                                             or os.environ.get("AWS_DEFAULT_REGION")),
                        help="AWS region (default: $AWS_REGION / "
                             "$AWS_DEFAULT_REGION, else the profile's region)")
    sub = parser.add_subparsers(dest="command")

    # validate
    p = sub.add_parser("validate", help="Check a link config against the schema")
    p.add_argument("file", help="Link config file (.yaml or .json)")
    p.add_argument("--show", action="store_true",
                   help="Print the canonical normalised config")

    # resolve
    p = sub.add_parser("resolve",
                       help="Show what ECDL reads from the config's ARNs")
    p.add_argument("file", help="Link config file (.yaml or .json)")
    p.add_argument("--json", action="store_true",
                   help="Also print the full resolution as JSON")

    # plan
    p = sub.add_parser("plan",
                       help="Show what deploying a link config would create")
    p.add_argument("file", help="Link config file (.yaml or .json)")
    p.add_argument("--json", action="store_true",
                   help="Also print the full plan as JSON")
    # apply
    p = sub.add_parser("apply", help="Deploy the link described by a link config")
    p.add_argument("file", help="Link config file (.yaml or .json)")
    p.add_argument("--dry-run", action="store_true",
                   help="Print the plan and stop")
    p.add_argument("--yes", "-y", action="store_true", help="Skip confirmation")
    p.add_argument("--reload", action="store_true",
                   help="On a link that is already deployed, run the bulk load "
                        "again (pausing capture around it). Without this, applying "
                        "to a deployed link only updates its stacks.")
    p.add_argument("--acknowledge", action="store_true",
                   help="With --yes: go ahead with a change that leaves the cache "
                        "needing a backfill or a cleanup (the steps are printed).")
    p.add_argument("--ignore-preflight", action="store_true",
                   help="Deploy even though the preflight blocks: the target fails "
                        "a requirement (an eviction policy that deletes cached rows), "
                        "or the source does (a missing table or column, GTIDs off, "
                        "a load longer than the log retention). It does not override "
                        "a key clash with another pipeline.")
    p.add_argument("--allow-downgrade", action="store_true",
                   help="update a link whose stacks run a newer release than this "
                        "CLI's templates (refused otherwise, so an old checkout "
                        "cannot move a link back to older images by accident)")
    p.add_argument("--offset-checked", action="store_true",
                   help="Pause capture for a load even though this machine cannot "
                        "read the broker to confirm Debezium committed a log "
                        "position. Only after checking the Debezium log: without a "
                        "committed position, changes made during the load are lost. "
                        "Deploying from the control plane does not need this.")
    p.add_argument("--reset-position", action="store_true",
                   help="With --reload: delete Debezium's stored log position and "
                        "start from the source's current one. For a link whose "
                        "position the source has purged (Debezium fails at start "
                        "with a missing binlog file or LSN). Needs the broker, so "
                        "only from the control plane's network.")
    p.add_argument("--load-timeout", type=_positive_minutes, metavar="MINUTES",
                   help="How long one table's load may run before the deploy stops "
                        "it and fails, for this run (default: the link's "
                        "advanced.loader.timeout_minutes, else 360). Capture stays "
                        "paused during the load, so the source must keep its log "
                        "for longer than that.")
    p.add_argument("--pg-slot-dropped", action="store_true",
                   help="With --reset-position on PostgreSQL: you stopped capture "
                        "and dropped the link's replication slot (the command is "
                        "printed when this is missing).")
    # signal
    p = sub.add_parser("signal", help="Day-2 signalling: prerequisite DDL, or ask "
                                      "for an incremental snapshot")
    p.add_argument("action", choices=["ddl", "snapshot"])
    p.add_argument("file", help="Link config file (.yaml or .json)")
    p.add_argument("--tables", help="Comma-separated tables to snapshot "
                                    "(default: every table in the link)")
    # diff
    p.add_argument("--wait", type=float, default=0, metavar="SECONDS",
                   help="snapshot: after you run the INSERT, watch the broker for up "
                        "to SECONDS and report whether Debezium read the signal "
                        "(consumed / finished / unverified). Needs network access "
                        "to the broker.")
    p = sub.add_parser("diff",
                       help="What changes between two link configs, and what it "
                            "would leave behind in the cache")
    p.add_argument("current", help="The config that is deployed now")
    p.add_argument("desired", help="The edited config")
    # status
    p = sub.add_parser("status", help="Show a stack's outputs")
    p.add_argument("--stack", required=True, help="Stack name")

    # destroy
    p = sub.add_parser("destroy",
                       help="Delete a pipeline's stacks (keeps the shared "
                            "source + target)")
    p.add_argument("--link", help="Pipeline/link name — deletes "
                                  "ecdl-<link>-{cdc,loader,broker}")
    p.add_argument("--prefix", default="ecdl",
                   help="Stack-name prefix (default: ecdl)")
    p.add_argument("--stack", help="[single-stack] delete one named stack directly")
    p.add_argument("--dry-run", action="store_true",
                   help="Show what would be deleted and stop")
    p.add_argument("--keep-cluster", action="store_true",
                   help="Do not delete the per-link ECS cluster even if empty")
    p.add_argument("--delete-backlog", action="store_true",
                   help="Delete the broker even though it holds changes not yet "
                        "written to the cache or dead letters (they are kept only "
                        "in its final snapshot). Needed with --yes.")
    p.add_argument("--yes", "-y", action="store_true", help="Skip confirmation")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return

    {"validate": cmd_validate, "resolve": cmd_resolve,
     "plan": cmd_plan, "apply": cmd_apply,
     "signal": cmd_signal, "diff": cmd_diff,
     "status": cmd_status, "destroy": cmd_destroy}[args.command](args)


if __name__ == "__main__":
    main()
