# kv_consumer saves nothing, so --key-factor 0: do not wait for chunks to reach Valkey.
b2_consumer_ttft ttft --key-factor 0
b5_consumer_bg0.00 load --bg-rate 0 --probe-kind miss --key-factor 0
b5_consumer_bg0.10 load --bg-rate 0.10 --probe-kind miss --key-factor 0
b5_consumer_bg0.20 load --bg-rate 0.20 --probe-kind miss --key-factor 0
b5_consumer_bg0.28 load --bg-rate 0.28 --probe-kind miss --key-factor 0
tc on
b2_consumer_tc_ttft ttft --key-factor 0
tc off
