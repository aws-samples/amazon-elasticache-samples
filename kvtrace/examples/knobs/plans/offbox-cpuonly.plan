w_cpuonly_4 load --probe-kinds miss,cpuhit --key-factor 0 --cpu-clear-url http://127.0.0.1:9001 --ext-write-gbps 4 --duration 120 --probe-rate 0.5 --probe-length 2048 --host-metrics --gpu-pcie --ext-writer glide --ext-procs 8 --ext-threads 2 --ext-value-bytes 6160384
